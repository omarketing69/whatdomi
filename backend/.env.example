# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas un .env real con secretos al repositorio.

# --- Backend ---
PORT=3000
CORS_ORIGIN=*

# Postgres con la extensión PostGIS habilitada.
# Con el docker-compose incluido: postgresql://whatdomi:whatdomi@localhost:5432/whatdomi
DATABASE_URL=postgresql://whatdomi:whatdomi@localhost:5432/whatdomi

# Radio de búsqueda de domiciliarios activos, en metros.
SEARCH_RADIUS_METERS=5000
# Máximo de domiciliarios candidatos a notificar por pedido.
MAX_CANDIDATES=5

# URL pública del frontend, usada por el webhook de WhatsApp para armar el
# link que se le envía al negocio ("completa los datos del pedido aquí").
WEB_APP_URL=http://localhost:5173

# --- WhatsApp Business (Meta Cloud API) ---
# Token que Meta te pide devolver al verificar la URL del webhook.
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-valor-secreto
# App secret de tu app de Meta, para verificar la firma X-Hub-Signature-256
# de los webhooks entrantes (pendiente de implementar, ver docs/ARCHITECTURE.md).
WHATSAPP_APP_SECRET=
# Token de acceso permanente del número de WhatsApp Business, para poder
# enviar mensajes salientes vía la Graph API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
