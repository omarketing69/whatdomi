# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas un .env real con secretos al repositorio.

# --- Backend ---
PORT=3000
CORS_ORIGIN=*

# Postgres con la extensión PostGIS habilitada.
# Con el docker-compose incluido: postgresql://whatdomi:whatdomi@localhost:5432/whatdomi
DATABASE_URL=postgresql://whatdomi:whatdomi@localhost:5432/whatdomi

# Radio de búsqueda de domiciliarios activos, en metros.
SEARCH_RADIUS_METERS=5000
# Máximo de domiciliarios candidatos en la cascada de asignación por pedido.
MAX_CANDIDATES=5
# Ventana (ms) que tiene cada candidato para aceptar antes de que la
# cascada pase automáticamente al siguiente más cercano. 60000 = 60s.
OFFER_TIMEOUT_MS=60000

# --- Tarifa y comisión ---
# IMPORTANTE: en Postgres estos valores solo se usan para SEMBRAR la fila
# inicial de `platform_config` (ver db/schema.sql); una vez existe esa
# fila, la fuente de verdad es la base de datos, editable por el admin
# desde /api/admin/config o el panel — cambiar estas variables después NO
# tiene efecto. Para el repositorio en memoria (tests/desarrollo sin
# Postgres) sí son la fuente de verdad en cada arranque.
FARE_BASE=3000
FARE_PER_KM=800
FARE_MIN=3000
FARE_CURRENCY=COP
# % de lo cobrado en cada servicio que el domiciliario le debe a la
# plataforma (ver SettlementService / liquidación diaria).
COMMISSION_PERCENTAGE=10

# --- Panel de administración ---
# Clave compartida para proteger /api/admin/* (configuración de tarifas,
# comisión, liquidaciones) y el monitoreo/reasignación de /api/orders. Sin
# esto configurado el panel queda ABIERTO — obligatorio en cualquier
# despliegue real, opcional solo en desarrollo local.
ADMIN_API_KEY=cambia-esto-por-un-valor-secreto

# --- Geocodificación ---
# Ciudad/país por defecto, usados como contexto cuando el solicitante no los
# menciona en la dirección (ej. "frente al parque central" sin decir la ciudad).
DEFAULT_CITY=
DEFAULT_COUNTRY=
# Si se define, se usa un LLM (Claude) para interpretar direcciones
# informales antes de geocodificarlas de verdad con Nominatim/OSM. Si se
# deja vacío, se manda el texto tal cual (+ ciudad/país) al geocodificador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- WhatsApp Business (Meta Cloud API) ---
# Token que Meta te pide devolver al verificar la URL del webhook.
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-valor-secreto
# App secret de tu app de Meta, para verificar la firma X-Hub-Signature-256
# de los webhooks entrantes (pendiente de implementar, ver docs/ARCHITECTURE.md).
WHATSAPP_APP_SECRET=
# Token de acceso permanente del número de WhatsApp Business, para poder
# enviar mensajes salientes vía la Graph API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Verificación facial (activación diaria del domiciliario) ---
# Distancia euclidiana máxima entre el descriptor de referencia y el de la
# selfie en vivo para considerarlas la misma persona (face-api.js recomienda
# 0.6 como valor por defecto para su modelo de reconocimiento). Más bajo =
# más estricto (más rechazos falsos); más alto = más permisivo.
FACE_MATCH_THRESHOLD=0.6

# --- Cierre de servicio por geocerca ---
# Radio (metros) alrededor del punto de entrega dentro del cual se
# considera que el domiciliario "llegó": el sistema marca el pedido como
# DELIVERED automáticamente (best-effort). El botón manual "Entregado" en
# la PWA del domiciliario sigue funcionando siempre como respaldo.
DELIVERY_GEOFENCE_METERS=100
